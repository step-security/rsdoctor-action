{
  "name": "@step-security/rsdoctor-action",
  "version": "1.1.4",
  "description": "A GitHub Action for Rsdoctor bundle size analysis and reporting",
  "keywords": [
    "github-action",
    "bundle-size",
    "performance",
    "analysis",
    "rsdoctor"
  ],
  "homepage": "https://github.com/step-security/rsdoctor-action#readme",
  "bugs": {
    "url": "https://github.com/step-security/rsdoctor-action/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/step-security/rsdoctor-action.git"
  },
  "license": "MIT",
  "author": "StepSecurity",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "action.yml",
    "README.md"
  ],
  "scripts": {
    "build": "rs lib && node build-helpers/sync-client-assets.mjs",
    "check": "rs check",
    "format": "rs fmt",
    "lint": "rs lint",
    "lint:fix": "rs lint --fix",
    "test": "rs test",
    "test:coverage": "rs test --coverage",
    "test:e2e": "playwright test",
    "test:watch": "rs test --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@actions/artifact": "^6.0.0",
    "@actions/core": "^2.0.0",
    "@actions/github": "^6.0.0",
    "@ai-sdk/anthropic": "^3.0.69",
    "@ai-sdk/deepseek": "^2.0.29",
    "@ai-sdk/google": "^3.0.63",
    "@ai-sdk/openai": "^3.0.52",
    "@playwright/test": "^1.42.1",
    "@rsdoctor/cli": "1.5.12",
    "@rsdoctor/client": "1.5.12",
    "@rstest/coverage-istanbul": "~0.11.11",
    "@types/node": "^24.5.2",
    "@types/node-fetch": "^2.6.11",
    "@types/yauzl": "^2.10.3",
    "ai": "^6.0.159",
    "axios": "^1.20.0",
    "fast-glob": "^3.3.3",
    "mock-fs": "^5.2.0",
    "nock": "^13.5.4",
    "rstack": "^0.7.2",
    "typescript": "^7.0.2",
    "yauzl": "^3.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
